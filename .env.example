# ==============================================================================
# VÉSTARA — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED FOR RUNTIME (Local & Production / Vercel)
# ------------------------------------------------------------------------------
# 1. Supabase Project Endpoint
VITE_SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Public / Anon API Key
# Either VITE_SUPABASE_ANON_KEY or VITE_SUPABASE_PUBLISHABLE_KEY is accepted.
# Both point to the exact same anonymous client key.
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# 3. Google Gemini API Key (Server-side only — powers AI Stylist & Try-On)
GEMINI_API_KEY=your-google-gemini-api-key

# ------------------------------------------------------------------------------
# OPTIONAL RUNTIME OVERRIDES
# ------------------------------------------------------------------------------
# Default model is "gemini-3.8-flash". Override with any Gemini model identifier
# (e.g., gemini-3.5-flash) if desired:
# GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# OPTIONAL DEVELOPMENT / CLI ONLY (NOT needed for running on Vercel)
# ------------------------------------------------------------------------------
# Only needed if you run offline Drizzle CLI migrations (e.g., drizzle-kit push):
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres